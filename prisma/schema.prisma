generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 사냥 기록 주인. 캐릭터마다 비밀번호가 있고, 그 비밀번호로만 기록을 보고 더한다.
model HuntCharacter {
  id           String   @id @default(uuid())
  /// 캐릭터명. 먼저 등록한 사람이 이 이름의 비밀번호를 정한다.
  name         String   @unique
  /// scrypt 해시. 비밀번호 원문은 저장하지 않는다. 세션 토큰의 서명 키로도 쓰므로 바꾸면 기존 세션이 끊긴다.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  hunts HuntRecord[]

  @@map("hunt_characters")
}

/// 재획 1차수. 브라우저가 만든 id로 올려서 다시 보내도 한 건만 남는다.
model HuntRecord {
  id          String   @id
  characterId String   @map("character_id")
  startedAt   DateTime @map("started_at")
  /// 조각 시세를 붙일 한국 날짜(사냥 시작일, YYYY-MM-DD).
  day         String
  /// 사냥 상태 전체(Hunt). 브라우저의 기록 형식을 그대로 담는다.
  data        Json
  updatedAt   DateTime @updatedAt @map("updated_at")

  character HuntCharacter  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  evidence  HuntEvidence[]

  @@index([characterId, startedAt(sort: Desc)])
  @@map("hunt_records")
}

/// 시작·종료 수량을 읽은 순간의 OCR 이미지. 영상 대신 남기는 증거라 차수당 몇 장만 둔다.
model HuntEvidence {
  id         String   @id @default(uuid())
  huntId     String   @map("hunt_id")
  /// baseline(시작) 또는 final(종료)
  kind       String
  capturedAt DateTime @default(now()) @map("captured_at")
  image      Bytes

  hunt HuntRecord @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@index([huntId, kind, capturedAt(sort: Desc)])
  @@map("hunt_evidence")
}
