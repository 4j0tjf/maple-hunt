# 사냥 기록 전용 DB. 시세 사이트(maple_market)와 같은 Postgres의 별도 데이터베이스다.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/maple_hunt?schema=public"
# 솔 에르다 조각 시세를 받아 올 시세 사이트 주소(이 PC 안).
MARKET_URL="http://127.0.0.1:3000"
# 넥슨 Open API 키(openapi.nexon.com에서 애플리케이션 등록 후 발급). 캐릭터 레벨·메소 획득량·아이템 드롭률을 가져온다.
NEXON_API_KEY=""
